---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import SocialIcon from "../components/SocialIcon.astro";
import { site } from "../data/site.js";
import retrato from "../assets/gallery/bombones-color.jpg";

const channels = [
  { icon: "instagram", label: "Instagram", value: `@${site.instagram.user}`, href: site.instagram.url, note: "El día a día, novedades y nuevas propuestas." },
  { icon: "whatsapp", label: "WhatsApp", value: site.whatsapp.display, href: site.whatsapp.url, note: "Para consultas rápidas y encargos." },
  { icon: "facebook", label: "Facebook", value: site.facebook.user, href: site.facebook.url, note: "Más de mi trabajo y comunidad." },
];
---

<Layout title="Contacto" description="Escribile a Florencia Miro por Instagram, WhatsApp o email." path="/contacto/">
  <section class="contact">
    <div class="wrap-wide contact__grid">
      <div class="contact__text">
        <p class="kicker">Hablemos</p>
        <h1>Dónde encontrarme</h1>
        <p class="contact__lead">
          La forma más rápida de estar al día con lo que cocino es seguirme en redes. Para consultas,
          colaboraciones o encargos, escribime por WhatsApp o mail y te respondo.
        </p>

        <ul class="channels">
          {channels.map((c) => (
            <li>
              <a href={c.href} target="_blank" rel="noopener" class="channel">
                <span class="channel__icon"><SocialIcon name={c.icon} /></span>
                <span class="channel__text">
                  <span class="channel__label">{c.label}</span>
                  <span class="channel__value">{c.value}</span>
                  <span class="channel__note">{c.note}</span>
                </span>
                <span class="channel__arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
          <li>
            <a href={`mailto:${site.email}`} class="channel">
              <span class="channel__icon channel__icon--mail">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6 8.5-6"/></svg>
              </span>
              <span class="channel__text">
                <span class="channel__label">Email</span>
                <span class="channel__value">{site.email}</span>
                <span class="channel__note">Para lo que necesites contarme con más detalle.</span>
              </span>
              <span class="channel__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        </ul>

        <p class="contact__loc">📍 {site.location}</p>
      </div>

      <figure class="contact__photo">
        <Image src={retrato} alt="Bombones pintados a mano" widths={[500, 800]} sizes="(max-width:800px) 90vw, 440px" loading="eager" />
        <figcaption>Cada propuesta está pensada para paladares exigentes.</figcaption>
      </figure>
    </div>
  </section>
</Layout>

<style>
  .contact { padding-block: clamp(3rem, 7vw, 5.5rem); }
  .contact__grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(2rem, 5vw, 4rem); align-items: start; }
  .contact h1 { margin: 0 0 1rem; }
  .contact__lead { font-size: 1.1rem; color: var(--ink-soft); max-width: 52ch; margin-bottom: 2rem; }

  .channels { list-style: none; padding: 0; margin: 0 0 2rem; display: grid; gap: .8rem; }
  .channel {
    display: flex; align-items: center; gap: 1.1rem; text-decoration: none; color: inherit;
    padding: 1.1rem 1.3rem; background: var(--cream); border: 1px solid var(--line);
    border-radius: var(--radius); transition: border-color .25s, transform .25s, box-shadow .25s;
  }
  .channel:hover { border-color: var(--caramel); transform: translateX(3px); box-shadow: 0 10px 24px rgba(42,28,23,.08); }
  .channel__icon { flex: none; width: 44px; height: 44px; display: grid; place-items: center; background: var(--ink); color: var(--cream); border-radius: 50%; }
  .channel__icon svg { width: 22px; height: 22px; }
  .channel__text { display: grid; flex: 1; }
  .channel__label { font-size: .74rem; letter-spacing: .1em; text-transform: uppercase; color: var(--caramel-deep); font-weight: 700; }
  .channel__value { font-family: var(--serif); font-size: 1.25rem; color: var(--ink); }
  .channel__note { font-size: .85rem; color: var(--ink-soft); }
  .channel__arrow { color: var(--caramel-deep); font-size: 1.2rem; }

  .contact__loc { font-size: .95rem; color: var(--ink-soft); }

  .contact__photo { margin: 0; border-radius: var(--radius); overflow: hidden; }
  .contact__photo img { width: 100%; aspect-ratio: 4/5; object-fit: cover; }
  .contact__photo figcaption { font-family: var(--serif); font-style: italic; font-size: 1.05rem; color: var(--ink-soft); padding: 1rem .2rem 0; }
  @media (max-width: 820px) { .contact__grid { grid-template-columns: 1fr; } .contact__photo { max-width: 440px; } }
</style>
