---
import { Image } from "astro:assets";
import { categories } from "../data/site.js";

const { items, showFilter = true } = Astro.props;
const usedCats = categories.filter((c) => items.some((i) => i.cat === c.id));
---

<div class="gallery" data-gallery>
  {showFilter && (
    <div class="gallery__filter" role="tablist" aria-label="Filtrar creaciones">
      <button class="chip is-active" data-filter="all" role="tab" aria-selected="true">Todo</button>
      {usedCats.map((c) => (
        <button class="chip" data-filter={c.id} role="tab" aria-selected="false">{c.label}</button>
      ))}
    </div>
  )}

  <div class="gallery__grid">
    {items.map((item, i) => (
      <figure class="tile" data-cat={item.cat}>
        <button class="tile__btn" data-index={i} aria-label={`Ampliar: ${item.title}`}>
          <Image
            src={item.img}
            alt={item.title}
            widths={[320, 480, 640]}
            sizes="(max-width: 600px) 50vw, (max-width: 1000px) 33vw, 300px"
            loading={i < 6 ? "eager" : "lazy"}
            class="tile__img"
          />
          <figcaption class="tile__cap">
            <span class="tile__title">{item.title}</span>
            <span class="tile__desc">{item.desc}</span>
          </figcaption>
        </button>
      </figure>
    ))}
  </div>
</div>

<!-- Lightbox -->
<dialog class="lightbox" data-lightbox aria-label="Vista ampliada">
  <button class="lightbox__close" data-lb-close aria-label="Cerrar">&times;</button>
  <button class="lightbox__nav lightbox__nav--prev" data-lb-prev aria-label="Anterior">&#8249;</button>
  <figure class="lightbox__fig">
    <img class="lightbox__img" data-lb-img alt="" />
    <figcaption class="lightbox__cap">
      <strong data-lb-title></strong>
      <span data-lb-desc></span>
    </figcaption>
  </figure>
  <button class="lightbox__nav lightbox__nav--next" data-lb-next aria-label="Siguiente">&#8250;</button>
</dialog>

<script>
  const roots = document.querySelectorAll("[data-gallery]");
  roots.forEach((root) => {
    // Filtros
    const chips = root.querySelectorAll(".chip");
    const tiles = root.querySelectorAll(".tile");
    chips.forEach((chip) =>
      chip.addEventListener("click", () => {
        const f = chip.getAttribute("data-filter");
        chips.forEach((c) => { c.classList.remove("is-active"); c.setAttribute("aria-selected", "false"); });
        chip.classList.add("is-active");
        chip.setAttribute("aria-selected", "true");
        tiles.forEach((t) => {
          const show = f === "all" || t.getAttribute("data-cat") === f;
          t.style.display = show ? "" : "none";
        });
      })
    );
  });

  // Lightbox (comparte datos de las figcaptions del DOM)
  const lb = document.querySelector("[data-lightbox]");
  if (lb) {
    const img = lb.querySelector("[data-lb-img]");
    const titleEl = lb.querySelector("[data-lb-title]");
    const descEl = lb.querySelector("[data-lb-desc]");
    const btns = [...document.querySelectorAll(".tile__btn")];
    let idx = 0;

    const dataFor = (btn) => {
      const pic = btn.querySelector("img");
      const srcset = pic.getAttribute("srcset") || pic.getAttribute("src");
      // tomar la URL más grande del srcset
      const big = srcset.split(",").map((s) => s.trim().split(" ")[0]).pop();
      return {
        src: big,
        title: btn.querySelector(".tile__title")?.textContent || "",
        desc: btn.querySelector(".tile__desc")?.textContent || "",
      };
    };
    const show = (i) => {
      const visible = btns.filter((b) => b.closest(".tile").style.display !== "none");
      if (!visible.length) return;
      idx = (i + visible.length) % visible.length;
      const d = dataFor(visible[idx]);
      img.src = d.src; img.alt = d.title;
      titleEl.textContent = d.title; descEl.textContent = d.desc;
      lb._visible = visible;
    };
    btns.forEach((btn) =>
      btn.addEventListener("click", () => {
        const visible = btns.filter((b) => b.closest(".tile").style.display !== "none");
        show(visible.indexOf(btn));
        if (!lb.open) lb.showModal();
      })
    );
    lb.querySelector("[data-lb-next]").addEventListener("click", () => show(idx + 1));
    lb.querySelector("[data-lb-prev]").addEventListener("click", () => show(idx - 1));
    lb.querySelector("[data-lb-close]").addEventListener("click", () => lb.close());
    lb.addEventListener("click", (e) => { if (e.target === lb) lb.close(); });
    document.addEventListener("keydown", (e) => {
      if (!lb.open) return;
      if (e.key === "ArrowRight") show(idx + 1);
      if (e.key === "ArrowLeft") show(idx - 1);
    });
  }
</script>

<style>
  .gallery__filter { display: flex; flex-wrap: wrap; gap: .6rem; margin-bottom: 2.2rem; }
  .chip {
    font-family: var(--sans); font-weight: 600; font-size: .9rem;
    padding: .5em 1.15em; border-radius: 999px; cursor: pointer;
    background: transparent; color: var(--ink-soft);
    border: 1px solid var(--line); transition: all .2s;
  }
  .chip:hover { border-color: var(--caramel); color: var(--ink); }
  .chip.is-active { background: var(--ink); color: var(--cream); border-color: var(--ink); }

  .gallery__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: clamp(.6rem, 1.4vw, 1.1rem);
  }
  .tile { margin: 0; }
  .tile__btn {
    display: block; width: 100%; padding: 0; border: 0; cursor: pointer;
    background: var(--ink); overflow: hidden; border-radius: var(--radius);
    position: relative; aspect-ratio: 1; isolation: isolate;
  }
  .tile__img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .6s cubic-bezier(.2,.7,.2,1), filter .4s;
  }
  .tile__btn:hover .tile__img { transform: scale(1.06); filter: brightness(.65); }
  .tile__btn:focus-visible .tile__img { filter: brightness(.65); }
  .tile__cap {
    position: absolute; inset: auto 0 0 0; z-index: 1;
    padding: 1.4rem 1rem 1rem; text-align: left; color: var(--cream);
    background: linear-gradient(to top, rgba(20,12,9,.92), transparent);
    opacity: 0; transform: translateY(8px); transition: opacity .35s, transform .35s;
  }
  .tile__btn:hover .tile__cap, .tile__btn:focus-visible .tile__cap { opacity: 1; transform: none; }
  .tile__title { display: block; font-family: var(--serif); font-size: 1.15rem; line-height: 1.1; }
  .tile__desc { display: block; font-size: .82rem; line-height: 1.4; margin-top: .3rem; color: color-mix(in srgb, var(--cream) 82%, transparent); }

  @media (max-width: 520px) {
    .gallery__grid { grid-template-columns: repeat(2, 1fr); }
    .tile__cap { opacity: 1; transform: none; padding: 1rem .7rem .7rem; }
    .tile__desc { display: none; }
    .tile__btn:hover .tile__img { filter: none; transform: none; }
  }

  /* Lightbox */
  .lightbox {
    border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh;
    width: 100%; height: 100%; margin: 0;
  }
  .lightbox::backdrop { background: rgba(18,11,8,.92); backdrop-filter: blur(3px); }
  .lightbox[open] { display: grid; grid-template-columns: auto 1fr auto; align-items: center; }
  .lightbox__fig { margin: 0; display: grid; place-items: center; padding: 2vh 1rem; gap: 1rem; }
  .lightbox__img {
    max-width: min(92vw, 820px); max-height: 78vh; object-fit: contain;
    border-radius: 3px; box-shadow: 0 20px 60px rgba(0,0,0,.5);
  }
  .lightbox__cap { text-align: center; color: var(--cream); font-family: var(--sans); max-width: 60ch; }
  .lightbox__cap strong { font-family: var(--serif); font-weight: 500; font-size: 1.4rem; display: block; margin-bottom: .2rem; }
  .lightbox__cap span { color: color-mix(in srgb, var(--cream) 78%, transparent); font-size: .95rem; }
  .lightbox__close {
    position: fixed; top: 1rem; right: 1.2rem; z-index: 2;
    background: none; border: 0; color: var(--cream); font-size: 2.6rem; line-height: 1;
    cursor: pointer; width: 48px; height: 48px;
  }
  .lightbox__nav {
    background: color-mix(in srgb, var(--cream) 12%, transparent); border: 0;
    color: var(--cream); font-size: 2.4rem; line-height: 1; cursor: pointer;
    width: 56px; height: 56px; border-radius: 50%; margin: 1rem; transition: background .2s;
  }
  .lightbox__nav:hover { background: color-mix(in srgb, var(--cream) 24%, transparent); }
  @media (max-width: 640px) {
    .lightbox__nav { width: 44px; height: 44px; font-size: 1.8rem; margin: .4rem; }
  }
</style>
