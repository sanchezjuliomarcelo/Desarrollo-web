---
import "../styles/global.css";
import { site, nav } from "../data/site.js";
import SocialIcon from "../components/SocialIcon.astro";

const { title, description, path = "" } = Astro.props;
const fullTitle = title ? `${title} · ${site.brand}` : `${site.name} · ${site.role}`;
const desc = description || site.tagline;
const canonical = new URL(path, Astro.site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#2a1c17" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,400&family=Mulish:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main" class="skip">Saltar al contenido</a>

    <header class="masthead" data-header>
      <div class="masthead__inner wrap-wide">
        <a href="/" class="brandmark" aria-label={`${site.brand} — inicio`}>
          <span class="brandmark__name">Flor Miro</span>
          <span class="brandmark__role">Pâtisserie · Chocolaterie</span>
        </a>

        <input type="checkbox" id="navtoggle" class="navtoggle" aria-hidden="true" />
        <label for="navtoggle" class="burger" aria-label="Abrir menú">
          <span></span><span></span><span></span>
        </label>

        <nav class="sitenav" aria-label="Principal">
          {nav.map((item) => (
            <a
              href={item.href}
              class="sitenav__link"
              aria-current={Astro.url.pathname === item.href ? "page" : undefined}
            >{item.label}</a>
          ))}
          <a href={site.instagram.url} class="sitenav__ig" target="_blank" rel="noopener" aria-label="Instagram">
            <SocialIcon name="instagram" />
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap-wide footer__grid">
        <div class="footer__brand">
          <p class="footer__logo">Flor Miro</p>
          <p class="footer__role">{site.role}</p>
          <p class="footer__loc">{site.location}</p>
        </div>

        <nav class="footer__nav" aria-label="Pie de página">
          <p class="footer__head">Navegar</p>
          {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>

        <div class="footer__contact">
          <p class="footer__head">Escribime</p>
          <a href={`mailto:${site.email}`}>{site.email}</a>
          <a href={site.whatsapp.url} target="_blank" rel="noopener">WhatsApp {site.whatsapp.display}</a>
          <div class="footer__social">
            <a href={site.instagram.url} target="_blank" rel="noopener" aria-label="Instagram"><SocialIcon name="instagram" /></a>
            <a href={site.facebook.url} target="_blank" rel="noopener" aria-label="Facebook"><SocialIcon name="facebook" /></a>
            <a href={site.whatsapp.url} target="_blank" rel="noopener" aria-label="WhatsApp"><SocialIcon name="whatsapp" /></a>
          </div>
        </div>
      </div>
      <div class="wrap-wide footer__base">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span>Hecho a mano en Buenos Aires</span>
      </div>
    </footer>

    <a href={site.whatsapp.url} class="wafloat" target="_blank" rel="noopener" aria-label="Escribir por WhatsApp">
      <SocialIcon name="whatsapp" />
    </a>

    <script>
      // Masthead: fondo sólido al desplazar.
      const h = document.querySelector("[data-header]");
      const onScroll = () => h?.classList.toggle("is-scrolled", window.scrollY > 24);
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
      // Cerrar menú móvil al navegar.
      document.querySelectorAll(".sitenav__link").forEach((l) =>
        l.addEventListener("click", () => {
          const t = document.getElementById("navtoggle");
          if (t) t.checked = false;
        })
      );
    </script>

    <style>
      .skip {
        position: absolute; left: -9999px; top: 0; z-index: 100;
        background: var(--ink); color: var(--cream); padding: .7rem 1rem;
      }
      .skip:focus { left: 1rem; top: 1rem; }

      /* ---- Masthead ---- */
      .masthead {
        position: sticky; top: 0; z-index: 50;
        transition: background .3s, box-shadow .3s, border-color .3s;
        border-bottom: 1px solid transparent;
      }
      .masthead.is-scrolled {
        background: color-mix(in srgb, var(--porcelain) 92%, transparent);
        backdrop-filter: blur(10px);
        border-bottom-color: var(--line);
      }
      .masthead__inner {
        display: flex; align-items: center; justify-content: space-between;
        padding-block: 1.1rem; gap: 1rem;
      }
      .brandmark { text-decoration: none; display: grid; line-height: 1; }
      .brandmark__name {
        font-family: var(--serif); font-size: 1.55rem; color: var(--ink);
        letter-spacing: -.01em;
      }
      .brandmark__role {
        font-size: .68rem; letter-spacing: .22em; text-transform: uppercase;
        color: var(--caramel-deep); margin-top: .3rem; font-weight: 600;
      }
      .sitenav { display: flex; align-items: center; gap: clamp(1rem, 2.4vw, 2.3rem); }
      .sitenav__link {
        font-weight: 600; font-size: .95rem; color: var(--ink);
        text-decoration: none; position: relative; padding-block: .2rem;
      }
      .sitenav__link::after {
        content: ""; position: absolute; left: 0; bottom: -2px; height: 1.5px; width: 0;
        background: var(--caramel); transition: width .25s;
      }
      .sitenav__link:hover::after,
      .sitenav__link[aria-current="page"]::after { width: 100%; }
      .sitenav__link[aria-current="page"] { color: var(--caramel-deep); }
      .sitenav__ig { color: var(--ink); display: inline-flex; }
      .sitenav__ig:hover { color: var(--caramel-deep); }
      .sitenav__ig svg { width: 20px; height: 20px; }

      .navtoggle, .burger { display: none; }

      @media (max-width: 820px) {
        .burger {
          display: inline-flex; flex-direction: column; gap: 5px;
          background: none; border: 0; cursor: pointer; padding: 6px; z-index: 60;
        }
        .burger span {
          width: 26px; height: 2px; background: var(--ink); border-radius: 2px;
          transition: transform .3s, opacity .3s;
        }
        .sitenav {
          position: fixed; inset: 0; background: var(--ink);
          flex-direction: column; justify-content: center; gap: 1.8rem;
          transform: translateX(100%); transition: transform .35s ease;
        }
        .sitenav__link { color: var(--cream); font-size: 1.5rem; font-family: var(--serif); }
        .sitenav__link[aria-current="page"] { color: var(--rose); }
        .sitenav__ig { color: var(--cream); }
        .navtoggle:checked ~ .sitenav { transform: translateX(0); }
        .navtoggle:checked ~ .burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
        .navtoggle:checked ~ .burger span:nth-child(2) { opacity: 0; }
        .navtoggle:checked ~ .burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
        .navtoggle:checked ~ .burger span { background: var(--cream); }
      }

      /* ---- Footer ---- */
      .footer { background: var(--ink); color: var(--porcelain); padding-top: clamp(3rem, 6vw, 5rem); }
      .footer a { color: var(--porcelain); text-decoration: none; }
      .footer a:hover { color: var(--rose); }
      .footer__grid {
        display: grid; grid-template-columns: 1.4fr 1fr 1.2fr; gap: 2.5rem;
        padding-bottom: 3rem; border-bottom: 1px solid var(--line-dark);
      }
      .footer__logo { font-family: var(--serif); font-size: 2rem; margin: 0 0 .3rem; }
      .footer__role { color: var(--rose); margin: 0 0 .3rem; }
      .footer__loc { color: color-mix(in srgb, var(--porcelain) 70%, transparent); margin: 0; font-size: .95rem; }
      .footer__nav, .footer__contact { display: flex; flex-direction: column; gap: .55rem; }
      .footer__head {
        font-variant: small-caps; letter-spacing: .05em; color: var(--caramel);
        font-family: var(--serif); font-size: 1.1rem; margin: 0 0 .6rem;
      }
      .footer__social { display: flex; gap: 1rem; margin-top: .8rem; }
      .footer__social svg { width: 22px; height: 22px; }
      .footer__base {
        display: flex; justify-content: space-between; padding-block: 1.6rem;
        font-size: .82rem; color: color-mix(in srgb, var(--porcelain) 60%, transparent);
        flex-wrap: wrap; gap: .5rem;
      }
      @media (max-width: 720px) {
        .footer__grid { grid-template-columns: 1fr; gap: 2rem; }
      }

      /* ---- WhatsApp flotante ---- */
      .wafloat {
        position: fixed; right: clamp(1rem, 3vw, 2rem); bottom: clamp(1rem, 3vw, 2rem);
        z-index: 40; width: 56px; height: 56px; border-radius: 50%;
        background: #25d366; color: #fff; display: grid; place-items: center;
        box-shadow: 0 8px 24px rgba(0,0,0,.22); transition: transform .25s;
      }
      .wafloat:hover { transform: scale(1.08); color: #fff; }
      .wafloat svg { width: 30px; height: 30px; }
    </style>
  </body>
</html>
