---
import { Image } from "astro:assets";
import Layout from "../../layouts/Layout.astro";
import { publishedRecipes, recipes } from "../../data/recipes.js";
import { site } from "../../data/site.js";

export function getStaticPaths() {
  return publishedRecipes.map((r) => ({ params: { slug: r.slug }, props: { recipe: r } }));
}
const { recipe } = Astro.props;
const byslug = Object.fromEntries(recipes.map((r) => [r.slug, r]));
const related = (recipe.related || [])
  .map((s) => byslug[s])
  .filter((r) => r && r.status === "published")
  .slice(0, 3);

// Ficha de tiempos y datos.
const timeLabels = { prep: "Preparación", cook: "Cocción", chill: "Frío", rest: "Reposo" };
const metaRows = [
  recipe.servings && { label: "Porciones", value: recipe.servings },
  recipe.moldSize && { label: "Molde", value: recipe.moldSize },
  recipe.difficulty && { label: "Dificultad", value: recipe.difficulty },
  ...Object.entries(recipe.times || {}).map(([k, v]) => ({ label: timeLabels[k] || k, value: v })),
].filter(Boolean);

// ISO 8601 para schema (sin inventar: sólo convierte lo declarado).
const toISO = (s) => {
  if (!s) return undefined;
  const h = /(\d+)\s*h/.exec(s);
  const m = /(\d+)\s*min/.exec(s) || /h\s*(\d+)/.exec(s);
  if (!h && !m) return undefined;
  return "PT" + (h ? `${h[1]}H` : "") + (m ? `${m[1]}M` : "");
};
const origin = Astro.site?.href;
const recipeUrl = new URL(`/recetas/${recipe.slug}/`, Astro.site).href;
const recipeSchema = {
  "@context": "https://schema.org",
  "@type": "Recipe",
  "@id": `${recipeUrl}#recipe`,
  name: recipe.title,
  description: recipe.intro,
  image: new URL(recipe.img.src, Astro.site).href,
  author: { "@id": `${origin}#person` },
  publisher: { "@id": `${origin}#person` },
  inLanguage: "es-AR",
  recipeCategory: recipe.cat,
  ...(recipe.cuisine ? { recipeCuisine: recipe.cuisine } : {}),
  ...(recipe.servings ? { recipeYield: recipe.servings } : {}),
  ...(toISO(recipe.times?.prep) ? { prepTime: toISO(recipe.times.prep) } : {}),
  ...(toISO(recipe.times?.cook) ? { cookTime: toISO(recipe.times.cook) } : {}),
  recipeIngredient: recipe.ingredientGroups.flatMap((g) => g.items),
  recipeInstructions: recipe.methodStages.map((st) => ({
    "@type": "HowToSection",
    name: st.heading,
    itemListElement: st.steps.map((text) => ({ "@type": "HowToStep", text })),
  })),
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Inicio", item: origin },
    { "@type": "ListItem", position: 2, name: "Recetas", item: new URL("/recetas/", Astro.site).href },
    { "@type": "ListItem", position: 3, name: recipe.title, item: recipeUrl },
  ],
};
---

<Layout
  title={recipe.title}
  description={recipe.subtitle || recipe.intro}
  path={`/recetas/${recipe.slug}/`}
  image={recipe.img.src}
  imageAlt={recipe.imageAlt}
  jsonld={[recipeSchema, breadcrumb]}
>
  <article class="recipe">
    <nav class="breadcrumb wrap" aria-label="Migas de pan">
      <ol>
        <li><a href="/">Inicio</a></li>
        <li><a href="/recetas/">Recetas</a></li>
        <li aria-current="page">{recipe.title}</li>
      </ol>
    </nav>

    <header class="recipe__hero">
      <div class="wrap recipe__hero-inner">
        <p class="recipe__cat">{recipe.cat}</p>
        <h1>{recipe.title}</h1>
        {recipe.subtitle && <p class="recipe__subtitle">{recipe.subtitle}</p>}
        {recipe.intro && <p class="recipe__intro">{recipe.intro}</p>}
      </div>
    </header>

    <figure class="recipe__photo">
      <Image src={recipe.img} alt={recipe.imageAlt} widths={[640, 1000, 1400]} sizes="(max-width:1100px) 100vw, 1040px" loading="eager" fetchpriority="high" />
    </figure>

    <div class="wrap">
      <dl class="recipe__meta">
        {metaRows.map((m) => (
          <div><dt>{m.label}</dt><dd>{m.value}</dd></div>
        ))}
      </dl>
    </div>

    <div class="wrap recipe__body">
      <section class="recipe__ingredients" aria-labelledby="ing">
        <h2 id="ing">Ingredientes</h2>
        {recipe.ingredientGroups.map((g) => (
          <div class="inggroup">
            <h3>{g.heading}</h3>
            <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        ))}
      </section>

      <section class="recipe__method" aria-labelledby="prep">
        <h2 id="prep">Preparación</h2>
        {recipe.methodStages.map((st, si) => (
          <div class="stage">
            <h3><span class="stage__n">{si + 1}</span>{st.heading}</h3>
            <ol>{st.steps.map((p) => <li>{p}</li>)}</ol>
          </div>
        ))}

        {recipe.florTip && (
          <aside class="callout callout--tip">
            <p class="callout__title">Tip de Flor</p>
            <p>{recipe.florTip}</p>
          </aside>
        )}
        {recipe.doneness && (
          <aside class="callout callout--done">
            <p class="callout__title">Cómo saber si está listo</p>
            <p>{recipe.doneness}</p>
          </aside>
        )}
        {recipe.commonMistakes?.length > 0 && (
          <div class="minisec">
            <h3>Errores comunes</h3>
            <ul class="minisec__list">{recipe.commonMistakes.map((m) => <li>{m}</li>)}</ul>
          </div>
        )}
        {recipe.storage && (
          <div class="minisec">
            <h3>Conservación</h3>
            <p>{recipe.storage}</p>
          </div>
        )}
      </section>
    </div>

    {related.length > 0 && (
      <section class="recipe__related">
        <div class="wrap-wide">
          <h2>Seguí con</h2>
          <div class="related__grid">
            {related.map((r) => (
              <a href={`/recetas/${r.slug}/`} class="relcard">
                <Image src={r.img} alt={r.imageAlt} widths={[320, 520]} sizes="(max-width:700px) 90vw, 340px" class="relcard__img" />
                <div class="relcard__body"><span>{r.cat}</span><h3>{r.title}</h3></div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .breadcrumb { padding-block: 1.2rem .4rem; }
  .breadcrumb ol { list-style: none; display: flex; flex-wrap: wrap; gap: .5rem; padding: 0; margin: 0; font-size: .85rem; color: var(--ink-soft); }
  .breadcrumb li:not(:last-child)::after { content: "›"; margin-left: .5rem; color: var(--caramel-deep); }
  .breadcrumb a { color: var(--caramel-deep); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
  .breadcrumb [aria-current="page"] { color: var(--ink); }

  .recipe__hero { padding-block: .8rem clamp(1.4rem, 3vw, 2.2rem); }
  .recipe__cat { font-variant: small-caps; letter-spacing: .05em; font-family: var(--serif); font-size: 1.1rem; color: var(--caramel-deep); margin: 0 0 .3rem; }
  .recipe__hero h1 { margin: 0 0 .6rem; max-width: 18ch; }
  .recipe__subtitle { font-family: var(--serif); font-size: clamp(1.15rem, 2.4vw, 1.6rem); color: var(--ink); margin: 0 0 1rem; max-width: 42ch; }
  .recipe__intro { font-size: 1.1rem; color: var(--ink-soft); max-width: 62ch; margin: 0; }

  .recipe__photo { margin: 0; }
  .recipe__photo img { width: 100%; max-height: 62vh; object-fit: cover; }

  .recipe__meta {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 1px;
    background: var(--line); border: 1px solid var(--line); border-radius: var(--radius);
    overflow: hidden; margin: clamp(2rem, 4vw, 3rem) 0 0;
  }
  .recipe__meta > div { background: var(--cream); padding: 1rem 1.2rem; }
  .recipe__meta dt { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: var(--caramel-deep); font-weight: 700; margin-bottom: .3rem; }
  .recipe__meta dd { margin: 0; font-family: var(--serif); font-size: 1.1rem; color: var(--ink); }

  .recipe__body { display: grid; grid-template-columns: .9fr 1.3fr; gap: clamp(2rem, 5vw, 4rem); padding-block: clamp(2.5rem, 5vw, 4rem); align-items: start; }
  .recipe__ingredients { position: sticky; top: 90px; background: var(--cream); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.6rem 1.7rem; }
  .recipe__ingredients h2 { font-size: 1.5rem; margin: 0 0 1.1rem; }
  .inggroup { margin-bottom: 1.2rem; }
  .inggroup:last-child { margin-bottom: 0; }
  .inggroup h3 { font-family: var(--serif); font-size: 1.05rem; color: var(--caramel-deep); margin: 0 0 .5rem; }
  .inggroup ul { list-style: none; padding: 0; margin: 0; }
  .inggroup li { padding: .4rem 0 .4rem 1.4rem; border-bottom: 1px solid var(--line); position: relative; font-size: .96rem; line-height: 1.4; }
  .inggroup li:last-child { border-bottom: 0; }
  .inggroup li::before { content: ""; position: absolute; left: 0; top: .85rem; width: 6px; height: 6px; background: var(--rose); border-radius: 50%; }

  .recipe__method h2 { font-size: 1.9rem; margin: 0 0 1.6rem; }
  .stage { margin-bottom: 1.8rem; }
  .stage h3 { font-family: var(--serif); font-size: 1.3rem; display: flex; align-items: center; gap: .7rem; margin: 0 0 .7rem; }
  .stage__n { flex: none; width: 1.9rem; height: 1.9rem; display: grid; place-items: center; font-size: .95rem; color: var(--caramel-deep); border: 1px solid var(--caramel); border-radius: 50%; }
  .stage ol { margin: 0; padding-left: 2.6rem; display: grid; gap: .6rem; }
  .stage li { color: var(--ink-soft); font-size: 1.05rem; line-height: 1.6; }

  .callout { border-radius: var(--radius); padding: 1.2rem 1.4rem; margin: 1.6rem 0; }
  .callout__title { font-family: var(--serif); font-size: 1.1rem; margin: 0 0 .3rem; }
  .callout p:not(.callout__title) { margin: 0; font-size: 1rem; }
  .callout--tip { background: var(--rose-tint); color: var(--ink); }
  .callout--done { background: var(--cream); border: 1px solid var(--line); color: var(--ink); }
  .callout--done .callout__title { color: var(--caramel-deep); }

  .minisec { margin-top: 1.6rem; }
  .minisec h3 { font-family: var(--serif); font-size: 1.2rem; color: var(--caramel-deep); margin: 0 0 .5rem; }
  .minisec p { color: var(--ink-soft); margin: 0; }
  .minisec__list { margin: 0; padding-left: 1.2rem; color: var(--ink-soft); display: grid; gap: .4rem; }

  @media (max-width: 820px) {
    .recipe__body { grid-template-columns: 1fr; }
    .recipe__ingredients { position: static; }
    .stage ol { padding-left: 0; }
  }

  .recipe__related { background: var(--cream); border-top: 1px solid var(--line); padding-block: clamp(2.5rem, 5vw, 4rem); }
  .recipe__related h2 { margin: 0 0 1.6rem; }
  .related__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .relcard { text-decoration: none; color: inherit; background: var(--porcelain); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; transition: transform .3s, box-shadow .3s; }
  .relcard:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(42,28,23,.12); }
  .relcard__img { width: 100%; aspect-ratio: 16/10; object-fit: cover; }
  .relcard__body { padding: 1rem 1.2rem 1.2rem; }
  .relcard__body span { font-variant: small-caps; letter-spacing: .04em; color: var(--caramel-deep); font-family: var(--serif); font-size: .95rem; }
  .relcard__body h3 { margin: .1rem 0 0; font-size: 1.15rem; }
  @media (max-width: 760px) { .related__grid { grid-template-columns: 1fr; } }
</style>
