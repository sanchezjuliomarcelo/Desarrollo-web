---
import { Image, getImage } from "astro:assets";
import { categories } from "../data/site.js";

const { items, showFilter = true, publishedRecipeSlugs = [] } = Astro.props;
const usedCats = categories.filter((c) => items.some((i) => i.cat === c.id));

// Precalcula las imágenes grandes de cada creación para el lightbox.
const lbData = await Promise.all(
  items.map(async (c) => ({
    slug: c.slug,
    title: c.title,
    desc: c.desc,
    recipeSlug: c.recipeSlug && publishedRecipeSlugs.includes(c.recipeSlug) ? c.recipeSlug : null,
    images: await Promise.all(
      c.images.map(async (im) => {
        const g = await getImage({ src: im.src, width: 1280, format: "webp" });
        return { src: g.src, alt: im.alt, label: im.label || null };
      })
    ),
  }))
);
---

<div class="gallery" data-gallery>
  {showFilter && (
    <div class="gallery__controls">
      <div class="gallery__filter" role="group" aria-label="Filtrar creaciones por tipo">
        <button class="chip is-active" data-filter="all" aria-pressed="true">Todas</button>
        {usedCats.map((c) => (
          <button class="chip" data-filter={c.id} aria-pressed="false">{c.label}</button>
        ))}
      </div>
      <p class="gallery__count" role="status" aria-live="polite" data-count></p>
    </div>
  )}

  <ul class="gallery__grid" role="list">
    {items.map((item, i) => (
      <li class="tile" data-cat={item.cat} data-slug={item.slug}>
        <button class="tile__btn" data-open={item.slug} aria-haspopup="dialog" aria-label={`Ampliar ${item.title}`}>
          <Image
            src={item.images[0].src}
            alt={item.images[0].alt}
            widths={[320, 480, 640]}
            sizes="(max-width: 600px) 50vw, (max-width: 1000px) 33vw, 300px"
            loading={i < 6 ? "eager" : "lazy"}
            class="tile__img"
          />
          {item.images.length > 1 && (
            <span class="tile__badge" aria-hidden="true">{item.images.length} fotos</span>
          )}
          <span class="tile__cap">
            <span class="tile__title">{item.title}</span>
            <span class="tile__desc">{item.desc}</span>
          </span>
        </button>
      </li>
    ))}
  </ul>
</div>

<script type="application/json" data-lb-data set:html={JSON.stringify(lbData)}></script>

<!-- Lightbox -->
<dialog class="lightbox" data-lightbox aria-label="Creación ampliada">
  <button class="lightbox__close" data-lb-close aria-label="Cerrar (Esc)">&times;</button>
  <button class="lightbox__nav lightbox__nav--prev" data-lb-prev aria-label="Imagen anterior">&#8249;</button>
  <figure class="lightbox__fig">
    <img class="lightbox__img" data-lb-img alt="" />
    <figcaption class="lightbox__cap">
      <strong data-lb-title></strong>
      <span class="lightbox__counter" data-lb-counter></span>
      <span data-lb-desc></span>
      <a class="lightbox__recipe" data-lb-recipe hidden>Ver la receta →</a>
    </figcaption>
  </figure>
  <button class="lightbox__nav lightbox__nav--next" data-lb-next aria-label="Imagen siguiente">&#8250;</button>
</dialog>

<script>
  const root = document.querySelector("[data-gallery]");
  const lbData = JSON.parse(document.querySelector("[data-lb-data]")?.textContent || "[]");
  const bySlug = Object.fromEntries(lbData.map((c) => [c.slug, c]));

  // ---- Filtros (aria-pressed + conteo + URL) ----
  if (root) {
    const chips = [...root.querySelectorAll(".chip")];
    const tiles = [...root.querySelectorAll(".tile")];
    const countEl = root.querySelector("[data-count]");
    const catLabel = { all: "creaciones", tortas: "tortas", tartas: "tartas y postres", chocolateria: "piezas de chocolatería", macarons: "macarons" };

    const apply = (f, updateHash = true) => {
      let n = 0;
      tiles.forEach((t) => {
        const show = f === "all" || t.getAttribute("data-cat") === f;
        t.hidden = !show;
        if (show) n++;
      });
      chips.forEach((c) => {
        const on = c.getAttribute("data-filter") === f;
        c.classList.toggle("is-active", on);
        c.setAttribute("aria-pressed", String(on));
      });
      if (countEl) countEl.textContent = `Mostrando ${n} ${catLabel[f] || "creaciones"}.`;
      if (updateHash) history.replaceState(null, "", f === "all" ? location.pathname : `#${f}`);
    };

    chips.forEach((chip) =>
      chip.addEventListener("click", () => apply(chip.getAttribute("data-filter")))
    );
    const fromHash = () => {
      const h = location.hash.replace("#", "");
      apply(chips.some((c) => c.getAttribute("data-filter") === h) ? h : "all", false);
    };
    window.addEventListener("hashchange", fromHash);
    fromHash();
  }

  // ---- Lightbox ----
  const lb = document.querySelector("[data-lightbox]");
  if (lb) {
    const img = lb.querySelector("[data-lb-img]");
    const titleEl = lb.querySelector("[data-lb-title]");
    const descEl = lb.querySelector("[data-lb-desc]");
    const counterEl = lb.querySelector("[data-lb-counter]");
    const recipeEl = lb.querySelector("[data-lb-recipe]");
    const prevBtn = lb.querySelector("[data-lb-prev]");
    const nextBtn = lb.querySelector("[data-lb-next]");
    let current = null, idx = 0, lastFocus = null;

    const render = () => {
      const im = current.images[idx];
      img.src = im.src; img.alt = im.alt;
      titleEl.textContent = current.title;
      descEl.textContent = current.desc;
      const multi = current.images.length > 1;
      counterEl.textContent = multi ? `${idx + 1} / ${current.images.length}${im.label ? " · " + im.label : ""}` : "";
      prevBtn.hidden = nextBtn.hidden = !multi;
      if (current.recipeSlug) {
        recipeEl.hidden = false;
        recipeEl.href = `/recetas/${current.recipeSlug}/`;
      } else recipeEl.hidden = true;
    };
    const step = (d) => { idx = (idx + d + current.images.length) % current.images.length; render(); };

    document.querySelectorAll(".tile__btn").forEach((btn) =>
      btn.addEventListener("click", () => {
        current = bySlug[btn.getAttribute("data-open")];
        if (!current) return;
        idx = 0; lastFocus = btn; render();
        if (!lb.open) lb.showModal();
      })
    );
    prevBtn.addEventListener("click", () => step(-1));
    nextBtn.addEventListener("click", () => step(1));
    lb.querySelector("[data-lb-close]").addEventListener("click", () => lb.close());
    lb.addEventListener("click", (e) => { if (e.target === lb) lb.close(); });
    lb.addEventListener("close", () => lastFocus?.focus());
    document.addEventListener("keydown", (e) => {
      if (!lb.open) return;
      if (e.key === "ArrowRight" && current.images.length > 1) step(1);
      if (e.key === "ArrowLeft" && current.images.length > 1) step(-1);
    });
  }
</script>

<style>
  .gallery__controls { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.4rem; margin-bottom: 2.2rem; }
  .gallery__filter { display: flex; flex-wrap: wrap; gap: .6rem; }
  .chip {
    font-family: var(--sans); font-weight: 600; font-size: .9rem;
    padding: .5em 1.15em; border-radius: 999px; cursor: pointer;
    background: transparent; color: var(--ink-soft);
    border: 1px solid var(--line); transition: all .2s;
  }
  .chip:hover { border-color: var(--caramel-deep); color: var(--ink); }
  .chip.is-active { background: var(--ink); color: var(--cream); border-color: var(--ink); }
  .gallery__count { margin: 0; font-size: .88rem; color: var(--ink-soft); }

  .gallery__grid {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
    gap: clamp(.6rem, 1.4vw, 1.1rem);
  }
  .tile { margin: 0; }
  .tile[hidden] { display: none; }
  .tile__btn {
    display: block; width: 100%; padding: 0; border: 0; cursor: pointer;
    background: var(--ink); overflow: hidden; border-radius: var(--radius);
    position: relative; aspect-ratio: 1; isolation: isolate;
  }
  .tile__img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform .6s cubic-bezier(.2,.7,.2,1), filter .4s;
  }
  .tile__btn:hover .tile__img { transform: scale(1.06); filter: brightness(.6); }
  .tile__btn:focus-visible .tile__img { filter: brightness(.6); }
  .tile__badge {
    position: absolute; top: .6rem; right: .6rem; z-index: 2;
    background: color-mix(in srgb, var(--ink) 72%, transparent); color: var(--cream);
    font-size: .68rem; font-weight: 600; letter-spacing: .02em;
    padding: .25em .6em; border-radius: 999px; backdrop-filter: blur(4px);
  }
  .tile__cap {
    position: absolute; inset: auto 0 0 0; z-index: 1;
    padding: 1.4rem 1rem 1rem; text-align: left; color: var(--cream);
    background: linear-gradient(to top, rgba(20,12,9,.92), transparent);
    opacity: 0; transform: translateY(8px); transition: opacity .35s, transform .35s;
  }
  .tile__btn:hover .tile__cap, .tile__btn:focus-visible .tile__cap { opacity: 1; transform: none; }
  .tile__title { display: block; font-family: var(--serif); font-size: 1.15rem; line-height: 1.1; }
  .tile__desc { display: block; font-size: .82rem; line-height: 1.4; margin-top: .3rem; color: color-mix(in srgb, var(--cream) 85%, transparent); }

  @media (max-width: 520px) {
    .gallery__grid { grid-template-columns: repeat(2, 1fr); }
    .tile__cap { opacity: 1; transform: none; padding: 1rem .7rem .7rem; }
    .tile__desc { display: none; }
    .tile__btn:hover .tile__img { filter: none; transform: none; }
  }

  /* Lightbox */
  .lightbox {
    border: 0; padding: 0; background: transparent; max-width: 100vw; max-height: 100vh;
    width: 100%; height: 100%; margin: 0;
  }
  .lightbox::backdrop { background: rgba(18,11,8,.92); backdrop-filter: blur(3px); }
  .lightbox[open] { display: grid; grid-template-columns: auto 1fr auto; align-items: center; }
  .lightbox__fig { margin: 0; display: grid; place-items: center; padding: 2vh 1rem; gap: .8rem; overflow-y: auto; max-height: 100vh; }
  .lightbox__img {
    max-width: min(92vw, 820px); max-height: 70vh; object-fit: contain;
    border-radius: 3px; box-shadow: 0 20px 60px rgba(0,0,0,.5);
  }
  .lightbox__cap { text-align: center; color: var(--cream); font-family: var(--sans); max-width: 62ch; display: grid; gap: .3rem; }
  .lightbox__cap strong { font-family: var(--serif); font-weight: 500; font-size: 1.4rem; }
  .lightbox__counter { font-size: .8rem; letter-spacing: .04em; color: var(--rose-tint); }
  .lightbox__cap span[data-lb-desc] { color: color-mix(in srgb, var(--cream) 80%, transparent); font-size: .95rem; }
  .lightbox__recipe { color: var(--cream); font-weight: 600; margin-top: .4rem; text-underline-offset: 3px; }
  .lightbox__recipe:hover { color: var(--rose-tint); }
  .lightbox__close {
    position: fixed; top: 1rem; right: 1.2rem; z-index: 2;
    background: none; border: 0; color: var(--cream); font-size: 2.6rem; line-height: 1;
    cursor: pointer; width: 48px; height: 48px;
  }
  .lightbox__nav {
    background: color-mix(in srgb, var(--cream) 12%, transparent); border: 0;
    color: var(--cream); font-size: 2.4rem; line-height: 1; cursor: pointer;
    width: 56px; height: 56px; border-radius: 50%; margin: 1rem; transition: background .2s;
  }
  .lightbox__nav:hover { background: color-mix(in srgb, var(--cream) 24%, transparent); }
  @media (max-width: 640px) {
    .lightbox__nav { width: 44px; height: 44px; font-size: 1.8rem; margin: .4rem; }
  }
</style>
