---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Gallery from "../components/Gallery.astro";
import { site, categories } from "../data/site.js";
import { creations } from "../data/creations.js";
import { recipes } from "../data/recipes.js";

import heroImg from "../assets/gallery/trufas-plato.jpg";
import catTortas from "../assets/gallery/selva-negra.jpg";
import catTartas from "../assets/gallery/tarta-higos.jpg";
import catChoco from "../assets/gallery/bombones-color.jpg";
import catMacarons from "../assets/gallery/macarons-color.jpg";
import portrait from "../assets/portraits/flor-retrato.jpg";
import betular from "../assets/portraits/con-betular.jpg";
import villar from "../assets/portraits/con-villar.jpg";
import nari from "../assets/portraits/con-nari.jpg";
import huevoPascua from "../assets/gallery/huevo-pascua.jpg";
import huevoOrange from "../assets/gallery/huevo-orange.jpg";
import huevoGreen from "../assets/gallery/huevo-green.jpg";
import huevoRocklets from "../assets/gallery/huevo-rocklets.jpg";

const catImg = { tortas: catTortas, tartas: catTartas, chocolateria: catChoco, macarons: catMacarons };
const featured = creations.filter((c) =>
  ["Selva Negra", "Macarons pintados", "Tarta de chocolate, higos y pistacho", "Bombones pintados",
   "Lemon Pie", "Arcoíris", "Rogel", "Box surtido", "Bavaroise de frutilla", "Trufas de café",
   "Tableta belga 70%", "Key Lime Pie"].includes(c.title)
).slice(0, 8);
const teaserRecipes = recipes.filter((r) => ["torta-selva-negra", "lemon-pie", "torta-rogel"].includes(r.slug));
---

<Layout
  path="/"
  description="Florencia Miro, chef pâtissier y chocolatier con más de 20 años de oficio en Buenos Aires. Portfolio de pastelería francesa, chocolatería de autor y clásicos argentinos, más recetas paso a paso."
>
  <!-- HERO -->
  <section class="hero">
    <Image src={heroImg} alt="Trufas de chocolate sobre cacao" class="hero__bg" widths={[800, 1280, 1800]} sizes="100vw" loading="eager" />
    <div class="hero__shade"></div>
    <div class="hero__inner wrap-wide">
      <p class="hero__eyebrow">Chef Pâtissier &amp; Chocolatier · Buenos Aires</p>
      <h1 class="hero__name">Florencia Miro</h1>
      <p class="hero__tag">{site.tagline}</p>
      <div class="hero__cta">
        <a href="/creaciones/" class="btn btn--light">Ver creaciones</a>
        <a href={site.instagram.url} target="_blank" rel="noopener" class="btn btn--ghost btn--on-dark">Seguir en Instagram</a>
      </div>
    </div>
    <a href="#manifiesto" class="hero__scroll" aria-label="Bajar">Bajar</a>
  </section>

  <!-- MANIFIESTO -->
  <section class="section manifesto" id="manifiesto">
    <div class="wrap manifesto__inner">
      <p class="kicker">La cocina como oficio</p>
      <p class="manifesto__lead">
        Soy cocinera, pastelera, chocolatera y bartender. Desde que tengo memoria me gané un lugar en
        la mesada, y hace más de veinte años hice de eso una profesión.
      </p>
      <p class="manifesto__body">
        Ninguna opción es al azar: cada propuesta está pensada para paladares exigentes, buscando el
        maridaje justo entre los ingredientes que la componen. Lo que ves acá es una selección de ese
        trabajo —pastelería francesa, clásicos argentinos y chocolatería de autor— hecho a mano, sin
        químicos ni conservantes añadidos.
      </p>
      <p class="manifesto__sign">Flor</p>
    </div>
  </section>

  <!-- CATEGORÍAS -->
  <section class="section cats">
    <div class="wrap-wide">
      <header class="sec-head">
        <p class="kicker">Qué hago</p>
        <h2>Cuatro mundos, una misma obsesión por el detalle</h2>
      </header>
      <div class="cats__grid">
        {categories.map((c) => (
          <a href={`/creaciones/#${c.id}`} class="catcard">
            <Image src={catImg[c.id]} alt={c.label} class="catcard__img" widths={[400, 640]} sizes="(max-width:700px) 50vw, 300px" />
            <div class="catcard__body">
              <h3>{c.label}</h3>
              <p>{c.blurb}</p>
              <span class="catcard__link">Explorar</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CREACIONES DESTACADAS -->
  <section class="section featured">
    <div class="wrap-wide">
      <header class="sec-head sec-head--row">
        <div>
          <p class="kicker">Portfolio</p>
          <h2>Creaciones seleccionadas</h2>
        </div>
        <a href="/creaciones/" class="btn btn--ghost">Ver todo el portfolio</a>
      </header>
      <Gallery items={featured} showFilter={false} />
    </div>
  </section>

  <!-- TEMPORADA -->
  <section class="section season">
    <div class="wrap-wide">
      <header class="sec-head">
        <p class="kicker">Ediciones de temporada</p>
        <h2>Lo que trae cada fecha</h2>
        <p class="season__lead">
          Hay creaciones que aparecen una vez al año. En Pascuas, huevos de chocolate pintados a mano,
          uno distinto del otro. En Navidad, el pan dulce artesanal de amasado lento, con frutos secos
          y cáscaras cítricas confitadas en casa.
        </p>
      </header>
      <div class="season__grid">
        <figure><Image src={huevoPascua} alt="Huevo de pascua multicolor pintado a mano" widths={[300, 480]} sizes="(max-width:700px) 45vw, 280px" /></figure>
        <figure><Image src={huevoOrange} alt="Huevo de pascua de autor" widths={[300, 480]} sizes="(max-width:700px) 45vw, 280px" /></figure>
        <figure><Image src={huevoGreen} alt="Huevo de pascua verde" widths={[300, 480]} sizes="(max-width:700px) 45vw, 280px" /></figure>
        <figure><Image src={huevoRocklets} alt="Huevos de chocolate con rocklets" widths={[300, 480]} sizes="(max-width:700px) 45vw, 280px" /></figure>
      </div>
    </div>
  </section>

  <!-- TRAYECTORIA -->
  <section class="section trajectory">
    <div class="wrap-wide trajectory__inner">
      <div class="trajectory__text">
        <p class="kicker">Formación</p>
        <h2>Una cocinera en formación permanente</h2>
        <p>
          Egresé del UTHGRA en 2003 y nunca dejé de estudiar: pastelería, panadería, chocolatería y
          coctelería, de la mano de maestros de reconocimiento internacional y de la mejor escuela de
          todas, la del ensayo y el error.
        </p>
        <a href="/sobre-flor/" class="btn btn--solid">Conocer mi historia</a>
      </div>
      <div class="trajectory__photos">
        <figure><Image src={betular} alt="Flor junto a Damián Betular" widths={[300, 500]} sizes="(max-width:700px) 40vw, 230px" /></figure>
        <figure><Image src={villar} alt="Flor junto a Pamela Villar" widths={[300, 500]} sizes="(max-width:700px) 40vw, 230px" /></figure>
        <figure><Image src={nari} alt="Flor junto a Gustavo Nari" widths={[300, 500]} sizes="(max-width:700px) 40vw, 230px" /></figure>
        <figure class="trajectory__portrait"><Image src={portrait} alt="Florencia Miro" widths={[300, 500]} sizes="(max-width:700px) 40vw, 230px" /></figure>
      </div>
    </div>
  </section>

  <!-- RECETAS -->
  <section class="section recipes-teaser">
    <div class="wrap-wide">
      <header class="sec-head sec-head--row">
        <div>
          <p class="kicker">Para hacer en casa</p>
          <h2>Mis recetas, paso a paso</h2>
        </div>
        <a href="/recetas/" class="btn btn--ghost">Ver todas las recetas</a>
      </header>
      <div class="rt__grid">
        {teaserRecipes.map((r) => (
          <a href={`/recetas/${r.slug}/`} class="rtcard">
            <Image src={r.img} alt={r.title} class="rtcard__img" widths={[400, 640]} sizes="(max-width:700px) 90vw, 360px" />
            <div class="rtcard__body">
              <span class="rtcard__cat">{r.cat}</span>
              <h3>{r.title}</h3>
              <p>{r.intro}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="cta-band">
    <div class="wrap cta-band__inner">
      <h2>¿Te gustó lo que viste?</h2>
      <p>Todos los días subo propuestas nuevas. Seguime, escribime y charlamos.</p>
      <div class="cta-band__btns">
        <a href={site.instagram.url} target="_blank" rel="noopener" class="btn btn--light">@{site.instagram.user}</a>
        <a href={site.whatsapp.url} target="_blank" rel="noopener" class="btn btn--ghost btn--on-dark">WhatsApp</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* HERO */
  .hero { position: relative; min-height: min(92vh, 820px); display: grid; align-items: end; overflow: hidden; }
  .hero__bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: -2; }
  .hero__shade {
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(180deg, rgba(20,12,9,.55) 0%, rgba(20,12,9,.25) 40%, rgba(20,12,9,.88) 100%);
  }
  .hero__inner { padding-block: clamp(3rem, 8vw, 6rem); color: var(--cream); }
  .hero__eyebrow { font-weight: 600; letter-spacing: .14em; text-transform: uppercase; font-size: .74rem; color: var(--rose-tint); margin: 0 0 1rem; }
  .hero__name { color: var(--cream); margin: 0 0 1rem; max-width: 14ch; }
  .hero__tag { font-size: clamp(1.05rem, 2vw, 1.3rem); max-width: 46ch; color: color-mix(in srgb, var(--cream) 90%, transparent); margin: 0 0 2rem; }
  .hero__cta { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn--on-dark { color: var(--cream); }
  .hero__scroll {
    position: absolute; left: 50%; bottom: 1.3rem; transform: translateX(-50%);
    color: var(--cream); font-size: .72rem; letter-spacing: .2em; text-transform: uppercase;
    text-decoration: none; writing-mode: vertical-rl; opacity: .7;
  }
  .hero__scroll::after { content: ""; display: block; width: 1px; height: 28px; background: currentColor; margin: .5rem auto 0; }

  .sec-head { margin-bottom: 2.6rem; max-width: 30ch; }
  .sec-head--row { display: flex; align-items: end; justify-content: space-between; gap: 1.5rem; max-width: none; flex-wrap: wrap; }
  .sec-head h2 { margin: 0; }

  /* MANIFIESTO */
  .manifesto { background: var(--cream); }
  .manifesto__inner { max-width: 760px; }
  .manifesto__lead { font-family: var(--serif); font-size: clamp(1.5rem, 3.3vw, 2.3rem); line-height: 1.28; color: var(--ink); max-width: 24ch; margin-bottom: 1.4rem; }
  .manifesto__body { font-size: 1.1rem; color: var(--ink-soft); max-width: 60ch; }
  .manifesto__sign { font-family: var(--serif); font-style: italic; font-size: 1.8rem; color: var(--caramel-deep); margin-top: 1.2rem; }

  /* CATEGORÍAS */
  .cats__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(1rem, 2vw, 1.6rem); }
  .catcard {
    text-decoration: none; color: inherit; display: block; background: var(--cream);
    border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line);
    transition: transform .3s, box-shadow .3s;
  }
  .catcard:hover { transform: translateY(-4px); box-shadow: 0 16px 36px rgba(42,28,23,.12); }
  .catcard__img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
  .catcard__body { padding: 1.3rem 1.3rem 1.5rem; }
  .catcard__body h3 { margin: 0 0 .4rem; }
  .catcard__body p { font-size: .9rem; color: var(--ink-soft); margin: 0 0 .9rem; }
  .catcard__link { font-weight: 700; font-size: .85rem; color: var(--caramel-deep); border-bottom: 1.5px solid var(--caramel); padding-bottom: 2px; }
  @media (max-width: 900px) { .cats__grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .cats__grid { grid-template-columns: 1fr; } }

  .featured { background: var(--porcelain); }

  /* TEMPORADA */
  .season { background: var(--cream); }
  .season .sec-head { max-width: 62ch; }
  .season__lead { color: var(--ink-soft); margin: 0; }
  .season__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.1rem; margin-top: 2.4rem; }
  .season__grid figure { margin: 0; border-radius: var(--radius); overflow: hidden; }
  .season__grid img { width: 100%; aspect-ratio: 4/5; object-fit: cover; transition: transform .6s cubic-bezier(.2,.7,.2,1); }
  .season__grid figure:hover img { transform: scale(1.05); }
  @media (max-width: 700px) { .season__grid { grid-template-columns: 1fr 1fr; } }

  /* TRAYECTORIA */
  .trajectory { background: var(--porcelain); }
  .trajectory__inner { display: grid; grid-template-columns: 1fr 1.1fr; gap: clamp(2rem, 5vw, 4.5rem); align-items: center; }
  .trajectory__text h2 { margin-bottom: 1rem; }
  .trajectory__text p { color: var(--ink-soft); margin-bottom: 1.8rem; }
  .trajectory__photos { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  .trajectory__photos figure { margin: 0; border-radius: var(--radius); overflow: hidden; }
  .trajectory__photos img { width: 100%; height: 100%; object-fit: cover; aspect-ratio: 3/4; }
  .trajectory__portrait { grid-row: span 1; }
  @media (max-width: 820px) { .trajectory__inner { grid-template-columns: 1fr; } }

  /* RECETAS TEASER */
  .recipes-teaser { background: var(--porcelain); }
  .rt__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.4rem; }
  .rtcard { text-decoration: none; color: inherit; background: var(--cream); border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); transition: transform .3s, box-shadow .3s; }
  .rtcard:hover { transform: translateY(-4px); box-shadow: 0 16px 36px rgba(42,28,23,.12); }
  .rtcard__img { width: 100%; aspect-ratio: 16/10; object-fit: cover; }
  .rtcard__body { padding: 1.2rem 1.3rem 1.5rem; }
  .rtcard__cat { font-variant: small-caps; letter-spacing: .04em; color: var(--caramel-deep); font-family: var(--serif); font-size: 1rem; }
  .rtcard__body h3 { margin: .2rem 0 .5rem; }
  .rtcard__body p { font-size: .9rem; color: var(--ink-soft); margin: 0; }
  @media (max-width: 820px) { .rt__grid { grid-template-columns: 1fr; } }

  /* CTA BAND */
  .cta-band { background: var(--ink); color: var(--cream); text-align: center; padding-block: clamp(3.5rem, 8vw, 6rem); }
  .cta-band h2 { color: var(--cream); margin-bottom: .6rem; }
  .cta-band p { color: color-mix(in srgb, var(--cream) 80%, transparent); margin: 0 auto 1.8rem; }
  .cta-band__inner { max-width: 620px; }
  .cta-band__btns { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
</style>
